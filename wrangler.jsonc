{
  // Cloudflare Workers deployment for eranchief.com (migrated from ChatGPT Sites).
  // Build: `node build.mjs` produces dist/client (static) and dist/server (Worker).
  "name": "eranchief",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "dist/client", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "eranchief", "migrations_dir": "drizzle" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "eranchief-stories" }
  ]
}
