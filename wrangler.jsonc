{
  // eranchief.com on Cloudflare Workers (migrated from ChatGPT Sites, October 2026).
  // `wrangler deploy` runs the build below, then uploads dist/client as static assets
  // and dist/server/index.js as the Worker (newsletter, collector stories, FX rates, redirects).
  "name": "eranchief-site",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "build": { "command": "node build.mjs" },
  "assets": { "directory": "dist/client", "binding": "ASSETS", "run_worker_first": ["/*", "!/assets/*"] },
  // D1 database for the newsletter and collector stories. No database_id: Wrangler provisions it
  // automatically on first deploy. Tables are created by the Worker on first use (ensureSchema).
  "d1_databases": [ { "binding": "DB", "database_name": "eranchief-site-db" } ],
  // Grow live endpoint (not a secret). The keys GROW_USER_ID and GROW_PAGE_CODE are Secrets set in the dashboard.
  // Keep variables added in the Cloudflare dashboard when deploying from git.
  "keep_vars": true,
  "vars": { "GROW_API_BASE": "https://secure.meshulam.co.il/api/light/server/1.0" }
  // Custom domains (eranchief.com, www) are attached in the Cloudflare dashboard, not here.
  // Optional later: R2 bucket (binding "BUCKET") for collector-story photos.
}
